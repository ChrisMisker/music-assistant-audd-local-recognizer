# Copy to .deploy.env (untracked) and adjust. Never put passwords or tokens here:
# use SSH key authentication. The AudD token lives only in the MA provider settings.
HA_HOST=homeassistant.local
HA_USER=homeassistant
HA_SSH_PORT=22
REMOTE_SRC=/share/music-assistant-audd-local-recognizer
# Leave empty to auto-detect the single running *music_assistant* container,
# e.g. addon_xxxxxxxx_music_assistant_nightly
MA_CONTAINER=
# Use "sudo -n docker" if the SSH user is not in the docker group (HA Advanced SSH add-on)
DOCKER=docker
# Prefix for writing to /share (root-owned on HA): "sudo -n" or empty
REMOTE_SUDO=
# mass.storage_path inside the container (the MA add-on uses /data)
MA_DATA_DIR=/data
# Where scripts/fetch-recordings.sh stores recordings on this Mac (default ./debug-recordings,
# git-ignored). May be an external disk, e.g. /Volumes/Data/audio-recognizer-corpus
RECORDINGS_DIR=
